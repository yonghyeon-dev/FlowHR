generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id                         String    @id @default(cuid())
  name                       String
  businessRegistrationNumber String?
  fiscalYearStart            String    @default("01-01")
  fiscalYearStartMonth       Int       @default(1)
  workHoursPerDay            Float     @default(8)
  standardWorkHoursPerDay    Float     @default(8)
  standardWorkDaysPerWeek    Int       @default(5)
  overtimeThreshold          Float     @default(8)
  overtimeThresholdHours     Float     @default(8)
  payPeriod                  PayPeriod @default(MONTHLY)
  industry                   String?
  representativeName         String?
  workStartTime              String?
  workEndTime                String?
  workDays                   Int[]     @default([])
  timezone                   String?
  currency                   String    @default("KRW")
  insuranceRateNps           Float?
  insuranceRateNhi           Float?
  insuranceRateEi            Float?
  insuranceRateWci           Float?
  isOnboardingComplete       Boolean   @default(false)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  employees                Employee[]
  departments              Department[]
  positions                Position[]
  approvalPolicy           ApprovalPolicy?
  approvalDelegations      ApprovalDelegation[]
  approvalLineTemplates    ApprovalLineTemplate[]
  approvalStageHistories   ApprovalStageHistory[]
  approvalExecutions       ApprovalExecution[]
  leavePolicies            LeavePolicy[]
  leavePromotionDeliveries LeavePromotionDelivery[]
  notices                  Notice[]
  noticeReadReceipts       NoticeReadReceipt[]
  noticeNotifications      NoticeNotificationQueue[]
  inAppNotifications       InAppNotification[]
  benefitCatalogItems      BenefitCatalogItem[]
  benefitRequests          BenefitRequest[]
  recruitmentOpenings      RecruitmentOpening[]
  recruitmentReferrals     RecruitmentReferral[]
  payrollRuns              PayrollRun[]
  deductionProfiles        DeductionProfile[]
  workScheduleTemplates    WorkScheduleTemplate[]
  scheduleAnomalyIncidents ScheduleAnomalyIncident[]
  auditLogs                AuditLog[]
  contractTemplates        ContractTemplate[]
}

model Employee {
  id             String         @id
  organizationId String?
  departmentId   String?
  positionId     String?
  name           String?
  email          String?
  phone          String?
  address        String?
  status         EmployeeStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization         Organization?           @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  department           Department?             @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  managedDepartments   Department[]            @relation("DepartmentManager")
  position             Position?               @relation(fields: [positionId], references: [id], onDelete: SetNull)
  attendanceRecords    AttendanceRecord[]
  workSchedules        WorkSchedule[]
  leaveRequests        LeaveRequest[]
  leaveBalance         LeaveBalanceProjection?
  onboardingTasks      OnboardingTask[]
  insuranceEnrollments InsuranceEnrollment[]
  payrollRuns          PayrollRun[]

  @@index([organizationId, status])
  @@index([departmentId])
  @@index([positionId])
}

model OnboardingTask {
  id         String               @id @default(cuid())
  employeeId String
  employee   Employee             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  title      String
  status     OnboardingTaskStatus @default(PENDING)
  createdAt  DateTime             @default(now())

  @@index([employeeId, createdAt, id], map: "OnboardingTask_employeeId_createdAt_id_idx")
  @@map("employee_onboarding_tasks")
}

model OnboardingTaskTemplate {
  id        String   @id @default(cuid())
  title     String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([sortOrder, createdAt, id], map: "onboarding_task_templates_sort_order_created_at_id_idx")
  @@map("onboarding_task_templates")
}

model InsuranceEnrollment {
  employeeId String
  employee   Employee                  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  type       InsuranceEnrollmentType
  status     InsuranceEnrollmentStatus
  enrolledAt DateTime?
  updatedAt  DateTime                  @updatedAt

  @@id([employeeId, type])
  @@index([employeeId, updatedAt])
}

model Department {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  active         Boolean  @default(true)
  parentId       String?
  managerId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parent       Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     Department[] @relation("DepartmentHierarchy")
  manager      Employee?    @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)
  employees    Employee[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
  @@index([parentId])
  @@index([managerId])
}

model Position {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  title          String
  grade          Int?
  description    String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employees    Employee[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
}

model ApprovalPolicy {
  id                     String   @id @default(cuid())
  organizationId         String   @unique
  attendanceApproverRole String   @default("manager")
  leaveApproverRole      String   @default("manager")
  payrollApproverRole    String   @default("payroll_operator")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model ApprovalDelegation {
  id              String         @id @default(cuid())
  organizationId  String
  domain          ApprovalDomain
  delegatorRole   String
  delegateActorId String
  reason          String?
  startsAt        DateTime
  endsAt          DateTime
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, domain, active, startsAt, endsAt])
  @@index([organizationId, delegateActorId, active])
}

model ApprovalLineTemplate {
  id                    String         @id @default(cuid())
  organizationId        String
  organization          Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name                  String
  domain                ApprovalDomain
  approverRoles         String[]
  approvalStagesJson    Json
  payrollGrossPayMinKrw Int?
  payrollGrossPayMaxKrw Int?
  active                Boolean        @default(true)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@unique([organizationId, domain, name])
  @@index([organizationId, domain, active, payrollGrossPayMinKrw, payrollGrossPayMaxKrw])
}

model ApprovalStageHistory {
  id                  String                  @id @default(cuid())
  organizationId      String
  organization        Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  domain              ApprovalDomain
  targetEntityType    String
  targetEntityId      String
  stageIndex          Int                     @default(1)
  stageLabel          String                  @default("policy-gate")
  requiredRoles       String[]
  fallbackRole        String
  matchedTemplateIds  String[]
  activeDelegationIds String[]
  actorRole           String
  actorId             String?
  allowed             Boolean
  resolution          ApprovalStageResolution
  payrollGrossPayKrw  Int?
  evaluatedAt         DateTime                @default(now())

  @@index([organizationId, domain, evaluatedAt])
  @@index([targetEntityType, targetEntityId, evaluatedAt])
}

model ApprovalExecution {
  id                String                 @id @default(cuid())
  organizationId    String
  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  domain            ApprovalDomain
  targetEntityType  String
  targetEntityId    String
  templateId        String?
  state             ApprovalExecutionState @default(PENDING)
  totalStages       Int
  currentStageIndex Int                    @default(1)
  startedAt         DateTime               @default(now())
  completedAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  actions ApprovalExecutionActionLog[]

  @@unique([organizationId, domain, targetEntityType, targetEntityId], name: "approval_execution_target_key")
  @@index([organizationId, state, updatedAt])
}

model ApprovalExecutionActionLog {
  id          String                  @id @default(cuid())
  executionId String
  execution   ApprovalExecution       @relation(fields: [executionId], references: [id], onDelete: Cascade)
  stageIndex  Int
  action      ApprovalExecutionAction
  actorRole   String
  actorId     String?
  resolution  ApprovalStageResolution
  createdAt   DateTime                @default(now())

  @@index([executionId, stageIndex, action, createdAt])
  @@index([executionId, actorId, stageIndex, action])
}

model Role {
  id          String   @id
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]

  @@index([name])
}

model RolePermission {
  roleId     String
  permission String
  createdAt  DateTime @default(now())

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@index([permission])
}

model AttendanceRecord {
  id                    String                   @id @default(cuid())
  employeeId            String
  employee              Employee                 @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  checkInAt             DateTime
  checkOutAt            DateTime?
  breakMinutes          Int                      @default(0)
  isHoliday             Boolean                  @default(false)
  notes                 String?
  anomalyType           String?
  captureChannel        AttendanceCaptureChannel @default(MANUAL)
  captureDeviceId       String?
  captureIpAddress      String?
  captureLatitude       Float?
  captureLongitude      Float?
  captureAccuracyMeters Int?
  state                 AttendanceState          @default(PENDING)
  approvedAt            DateTime?
  approvedBy            String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
}

model WorkSchedule {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  startAt      DateTime
  endAt        DateTime
  breakMinutes Int      @default(0)
  isHoliday    Boolean  @default(false)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([employeeId, startAt, endAt])
}

model WorkScheduleTemplate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  startMinute    Int
  endMinute      Int
  breakMinutes   Int          @default(0)
  isHoliday      Boolean      @default(false)
  weekdays       Int[]
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, name])
}

model ScheduleAnomalyIncident {
  incidentId                String                                 @id
  organizationId            String?
  organization              Organization?                          @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  state                     ScheduleAnomalyIncidentState
  assigneeId                String?
  resolutionCode            ScheduleAnomalyIncidentResolutionCode?
  note                      String?
  updatedAt                 DateTime
  updatedByActorId          String?
  updatedByActorRole        String
  lastEscalationRequestedAt DateTime?
  history                   Json
  createdAt                 DateTime                               @default(now())
  rowUpdatedAt              DateTime                               @updatedAt

  @@index([organizationId, state, updatedAt])
  @@index([organizationId, assigneeId, updatedAt])
}

model LeaveRequest {
  id             String            @id @default(cuid())
  employeeId     String
  employee       Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  policyId       String?
  policy         LeavePolicy?      @relation(fields: [policyId], references: [id], onDelete: SetNull)
  leaveType      LeaveType         @default(ANNUAL)
  startDate      DateTime
  endDate        DateTime
  unit           LeaveRequestUnit  @default(FULL_DAY)
  hours          Decimal?          @db.Decimal(6, 2)
  days           Decimal           @db.Decimal(6, 2)
  reason         String?
  state          LeaveRequestState @default(PENDING)
  decisionReason String?
  approvedAt     DateTime?
  approvedBy     String?
  rejectedAt     DateTime?
  rejectedBy     String?
  canceledAt     DateTime?
  canceledBy     String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  approvals      LeaveApproval[]

  @@index([employeeId, state, startDate, endDate])
  @@index([policyId, state, startDate, endDate])
}

model LeaveApproval {
  id        String              @id @default(cuid())
  requestId String
  action    LeaveDecisionAction
  actorId   String
  actorRole String
  reason    String?
  createdAt DateTime            @default(now())
  request   LeaveRequest        @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}

model LeaveBalanceProjection {
  employeeId      String   @id
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  grantedDays     Decimal  @default(15) @db.Decimal(6, 2)
  usedDays        Decimal  @default(0) @db.Decimal(6, 2)
  remainingDays   Decimal  @default(15) @db.Decimal(6, 2)
  carryOverDays   Decimal  @default(0) @db.Decimal(6, 2)
  lastAccrualYear Int?
  updatedAt       DateTime @updatedAt
}

model LeavePolicy {
  id                                  String            @id @default(cuid())
  organizationId                      String
  organization                        Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                                String            @default("Default Leave Policy")
  isStatutory                         Boolean           @default(false)
  status                              LeavePolicyStatus @default(ACTIVE)
  annualGrantDays                     Int               @default(15)
  carryOverCapDays                    Int               @default(5)
  allowHalfDay                        Boolean           @default(true)
  allowHourly                         Boolean           @default(true)
  hourlyIncrementMinutes              Int               @default(30)
  maxHoursPerRequest                  Decimal           @default(8) @db.Decimal(6, 2)
  minNoticeDays                       Int               @default(0)
  maxConsecutiveDays                  Decimal?          @db.Decimal(6, 2)
  annualLeavePromotionEnabled         Boolean           @default(false)
  annualLeavePromotionThresholdDays   Decimal           @default(5) @db.Decimal(6, 2)
  annualLeavePromotionLeadDays        Int               @default(30)
  annualLeavePromotionMessageTemplate String?
  createdAt                           DateTime          @default(now())
  updatedAt                           DateTime          @updatedAt
  requests                            LeaveRequest[]

  @@index([organizationId, status, isStatutory, updatedAt])
  @@index([organizationId, isStatutory, updatedAt])
}

model LeavePromotionDelivery {
  id                   String                            @id @default(cuid())
  organizationId       String
  organization         Organization                      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  asOf                 DateTime
  includeUpcoming      Boolean
  dryRun               Boolean
  channel              LeavePromotionDeliveryChannel
  provider             String?
  status               LeavePromotionDeliveryStatus
  announcementTitle    String
  announcementBody     String
  targetCount          Int
  recipientCount       Int
  missingEmailCount    Int
  sentTargetCount      Int
  webhookSource        String?
  emailTemplateSource  String?
  emailTemplateId      String?
  dispatchedAt         DateTime?
  requestedByActorRole String
  requestedByActorId   String?
  retryOfDeliveryId    String?
  retryOfDelivery      LeavePromotionDelivery?           @relation("LeavePromotionDeliveryRetry", fields: [retryOfDeliveryId], references: [id], onDelete: SetNull)
  retryDeliveries      LeavePromotionDelivery[]          @relation("LeavePromotionDeliveryRetry")
  recipients           LeavePromotionDeliveryRecipient[]
  createdAt            DateTime                          @default(now())
  updatedAt            DateTime                          @updatedAt

  @@index([organizationId, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, channel, createdAt])
  @@index([retryOfDeliveryId])
}

model LeavePromotionDeliveryRecipient {
  id              String                        @id @default(cuid())
  deliveryId      String
  delivery        LeavePromotionDelivery        @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  employeeId      String
  email           String?
  name            String?
  remainingDays   Decimal                       @db.Decimal(6, 2)
  grantedDays     Decimal                       @db.Decimal(6, 2)
  usedDays        Decimal                       @db.Decimal(6, 2)
  lastAccrualYear Int?
  eligibleNow     Boolean
  status          LeavePromotionRecipientStatus
  lastError       String?
  sentAt          DateTime?
  retryCount      Int                           @default(0)
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt

  @@index([deliveryId, status, createdAt])
  @@index([employeeId, createdAt])
}

model Notice {
  id                  String                    @id @default(cuid())
  organizationId      String
  organization        Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  title               String
  body                String
  audience            NoticeAudience
  targetDepartmentIds String[]                  @default([])
  status              NoticeStatus              @default(DRAFT)
  publishAt           DateTime?
  publishedAt         DateTime?
  createdByActorId    String
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  readReceipts        NoticeReadReceipt[]
  notifications       NoticeNotificationQueue[]

  @@index([organizationId, status, updatedAt])
  @@index([organizationId, audience, updatedAt])
}

model NoticeReadReceipt {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  noticeId       String
  notice         Notice       @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  actorId        String
  readAt         DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, noticeId, actorId], name: "notice_receipt_org_notice_actor_key")
  @@index([organizationId, actorId, readAt])
  @@index([noticeId, readAt])
}

model NoticeNotificationQueue {
  id             String                    @id @default(cuid())
  organizationId String
  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  noticeId       String
  notice         Notice                    @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  audience       NoticeAudience
  channel        NoticeNotificationChannel
  state          NoticeNotificationState   @default(QUEUED)
  enqueuedAt     DateTime
  deliveredAt    DateTime?
  lastError      String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([organizationId, state, enqueuedAt])
  @@index([noticeId, enqueuedAt])
}

model InAppNotification {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  recipientId    String
  type           String
  title          String
  body           String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  readAt         DateTime?

  @@index([organizationId, recipientId, createdAt])
  @@index([organizationId, recipientId, isRead, createdAt])
}

model RecruitmentOpening {
  id              String                   @id @default(cuid())
  organizationId  String
  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  title           String
  department      String
  employmentType  String
  hiringManagerId String?
  status          RecruitmentOpeningStatus @default(OPEN)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  referrals       RecruitmentReferral[]

  @@index([organizationId, status, updatedAt])
}

model RecruitmentReferral {
  id                 String                   @id @default(cuid())
  organizationId     String
  organization       Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  openingId          String
  opening            RecruitmentOpening       @relation(fields: [openingId], references: [id], onDelete: Restrict)
  candidateName      String
  candidateEmail     String
  referrerEmployeeId String
  note               String
  stage              RecruitmentReferralStage @default(SUBMITTED)
  stageReason        String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@index([organizationId, stage, updatedAt])
  @@index([organizationId, referrerEmployeeId, updatedAt])
  @@index([openingId, updatedAt])
}

model BenefitCatalogItem {
  id                  String               @id @default(cuid())
  organizationId      String
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name                String
  description         String
  annualLimitKrw      Int
  status              BenefitCatalogStatus @default(ACTIVE)
  enrollmentStartDate String?
  enrollmentEndDate   String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  requests            BenefitRequest[]

  @@index([organizationId, status, updatedAt])
  @@index([organizationId, updatedAt])
}

model BenefitRequest {
  id                String               @id @default(cuid())
  organizationId    String
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  benefitId         String
  benefit           BenefitCatalogItem   @relation(fields: [benefitId], references: [id], onDelete: Restrict)
  employeeId        String
  amountKrw         Int
  reason            String
  status            BenefitRequestStatus @default(SUBMITTED)
  requestedAt       DateTime
  reviewedAt        DateTime?
  reviewedByActorId String?
  reviewNote        String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([organizationId, status, updatedAt])
  @@index([organizationId, employeeId, updatedAt])
  @@index([benefitId, updatedAt])
}

model PayrollRun {
  id                        String        @id @default(cuid())
  organizationId            String?
  organization              Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  employeeId                String?
  employee                  Employee?     @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  periodStart               DateTime
  periodEnd                 DateTime
  state                     PayrollState  @default(PREVIEWED)
  grossPayKrw               Int
  withholdingTaxKrw         Int?
  socialInsuranceKrw        Int?
  otherDeductionsKrw        Int?
  totalDeductionsKrw        Int?
  netPayKrw                 Int?
  deductionBreakdown        Json?
  deductionProfileId        String?
  deductionProfileVersion   Int?
  sourceRecordCount         Int           @default(0)
  payslipDeliveryChannel    String?
  payslipDistributedAt      DateTime?
  payslipDistributedBy      String?
  payslipReceiptConfirmedAt DateTime?
  payslipReceiptConfirmedBy String?
  confirmedAt               DateTime?
  confirmedBy               String?
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  @@index([organizationId, periodStart, periodEnd])
}

model DeductionProfile {
  id                     String        @id
  organizationId         String?
  organization           Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  name                   String
  version                Int
  mode                   String
  withholdingRate        Decimal?      @db.Decimal(5, 4)
  socialInsuranceRate    Decimal?      @db.Decimal(5, 4)
  fixedOtherDeductionKrw Int           @default(0)
  active                 Boolean       @default(true)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@index([organizationId, active])
}

model AuditLog {
  id             String        @id @default(cuid())
  action         String
  entityType     String
  entityId       String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actorRole      String
  actorId        String?
  payload        Json?
  createdAt      DateTime      @default(now())

  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@index([organizationId, createdAt])
}

model ContractTemplate {
  id             String   @id
  organizationId String
  name           String
  category       String
  body           String
  status         String
  version        Int      @default(1)
  isArchived     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, isArchived, updatedAt])
}

model PersonalDataConsent {
  id          String                  @id @default(cuid())
  userId      String
  consentType PersonalDataConsentType
  consentedAt DateTime                @default(now())
  version     String
  ipAddress   String?
  createdAt   DateTime                @default(now())

  @@unique([userId, consentType, version], name: "personal_data_consent_user_type_version_key")
  @@index([userId, consentedAt])
}

enum AttendanceState {
  PENDING
  APPROVED
  REJECTED
}

enum AttendanceCaptureChannel {
  MANUAL
  GPS
  QR
  WIFI
  DEVICE
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  MATERNITY
  PATERNITY
}

enum LeaveRequestState {
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

enum LeaveDecisionAction {
  APPROVED
  REJECTED
  CANCELED
}

enum LeaveRequestUnit {
  FULL_DAY
  HALF_DAY
  HOUR
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  RESIGNED
}

enum LeavePromotionDeliveryChannel {
  webhook
  email_template
}

enum LeavePromotionDeliveryStatus {
  dry_run
  skipped_no_targets
  dispatched
  failed
}

