generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Employee[]
  departments Department[]
  positions Position[]
  approvalPolicy ApprovalPolicy?
  approvalDelegations ApprovalDelegation[]
  leavePolicy LeavePolicy?
  payrollRuns PayrollRun[]
  deductionProfiles DeductionProfile[]
  workScheduleTemplates WorkScheduleTemplate[]
  scheduleAnomalyIncidents ScheduleAnomalyIncident[]
  auditLogs AuditLog[]
}

model Employee {
  id             String   @id
  organizationId String?
  departmentId   String?
  positionId     String?
  name           String?
  email          String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position Position? @relation(fields: [positionId], references: [id], onDelete: SetNull)
  attendanceRecords AttendanceRecord[]
  workSchedules      WorkSchedule[]
  leaveRequests      LeaveRequest[]
  leaveBalance       LeaveBalanceProjection?
  payrollRuns        PayrollRun[]

  @@index([organizationId, active])
  @@index([departmentId])
  @@index([positionId])
}

model Department {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employees Employee[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
}

model Position {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employees Employee[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
}

model ApprovalPolicy {
  id                     String       @id @default(cuid())
  organizationId         String       @unique
  attendanceApproverRole String       @default("manager")
  leaveApproverRole      String       @default("manager")
  payrollApproverRole    String       @default("payroll_operator")
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model ApprovalDelegation {
  id              String         @id @default(cuid())
  organizationId  String
  domain          ApprovalDomain
  delegatorRole   String
  delegateActorId String
  reason          String?
  startsAt        DateTime
  endsAt          DateTime
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, domain, active, startsAt, endsAt])
  @@index([organizationId, delegateActorId, active])
}

model Role {
  id          String   @id
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]

  @@index([name])
}

model RolePermission {
  roleId     String
  permission String
  createdAt  DateTime @default(now())

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@index([permission])
}

model AttendanceRecord {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  checkInAt    DateTime
  checkOutAt   DateTime?
  breakMinutes Int      @default(0)
  isHoliday    Boolean  @default(false)
  notes        String?
  captureChannel       AttendanceCaptureChannel @default(MANUAL)
  captureDeviceId      String?
  captureIpAddress     String?
  captureLatitude      Float?
  captureLongitude     Float?
  captureAccuracyMeters Int?
  state        AttendanceState @default(PENDING)
  approvedAt   DateTime?
  approvedBy   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model WorkSchedule {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  startAt      DateTime
  endAt        DateTime
  breakMinutes Int      @default(0)
  isHoliday    Boolean  @default(false)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([employeeId, startAt, endAt])
}

model WorkScheduleTemplate {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  startMinute    Int
  endMinute      Int
  breakMinutes   Int      @default(0)
  isHoliday      Boolean  @default(false)
  weekdays       Int[]
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, name])
}

model ScheduleAnomalyIncident {
  incidentId String @id
  organizationId String?
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  state ScheduleAnomalyIncidentState
  assigneeId String?
  resolutionCode ScheduleAnomalyIncidentResolutionCode?
  note String?
  updatedAt DateTime
  updatedByActorId String?
  updatedByActorRole String
  lastEscalationRequestedAt DateTime?
  history Json
  createdAt DateTime @default(now())
  rowUpdatedAt DateTime @updatedAt

  @@index([organizationId, state, updatedAt])
  @@index([organizationId, assigneeId, updatedAt])
}

model LeaveRequest {
  id             String           @id @default(cuid())
  employeeId     String
  employee       Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leaveType      LeaveType        @default(ANNUAL)
  startDate      DateTime
  endDate        DateTime
  unit           LeaveRequestUnit @default(FULL_DAY)
  hours          Decimal?         @db.Decimal(6, 2)
  days           Decimal          @db.Decimal(6, 2)
  reason         String?
  state          LeaveRequestState @default(PENDING)
  decisionReason String?
  approvedAt     DateTime?
  approvedBy     String?
  rejectedAt     DateTime?
  rejectedBy     String?
  canceledAt     DateTime?
  canceledBy     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  approvals      LeaveApproval[]

  @@index([employeeId, state, startDate, endDate])
}

model LeaveApproval {
  id        String             @id @default(cuid())
  requestId String
  action    LeaveDecisionAction
  actorId   String
  actorRole String
  reason    String?
  createdAt DateTime           @default(now())
  request   LeaveRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}

model LeaveBalanceProjection {
  employeeId      String   @id
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  grantedDays     Decimal  @default(15) @db.Decimal(6, 2)
  usedDays        Decimal  @default(0) @db.Decimal(6, 2)
  remainingDays   Decimal  @default(15) @db.Decimal(6, 2)
  carryOverDays   Decimal  @default(0) @db.Decimal(6, 2)
  lastAccrualYear Int?
  updatedAt       DateTime @updatedAt
}

model LeavePolicy {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  annualGrantDays Int         @default(15)
  carryOverCapDays Int        @default(5)
  allowHalfDay    Boolean     @default(true)
  allowHourly     Boolean     @default(true)
  hourlyIncrementMinutes Int  @default(30)
  maxHoursPerRequest Decimal  @default(8) @db.Decimal(6, 2)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model PayrollRun {
  id                     String   @id @default(cuid())
  organizationId         String?
  organization           Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  employeeId             String?
  employee               Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  periodStart            DateTime
  periodEnd              DateTime
  state                  PayrollState @default(PREVIEWED)
  grossPayKrw            Int
  withholdingTaxKrw      Int?
  socialInsuranceKrw     Int?
  otherDeductionsKrw     Int?
  totalDeductionsKrw     Int?
  netPayKrw              Int?
  deductionBreakdown     Json?
  deductionProfileId     String?
  deductionProfileVersion Int?
  sourceRecordCount      Int      @default(0)
  confirmedAt            DateTime?
  confirmedBy            String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([organizationId, periodStart, periodEnd])
}

model DeductionProfile {
  id                     String   @id
  organizationId         String?
  organization           Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  name                   String
  version                Int
  mode                   String
  withholdingRate        Decimal? @db.Decimal(5, 4)
  socialInsuranceRate    Decimal? @db.Decimal(5, 4)
  fixedOtherDeductionKrw Int      @default(0)
  active                 Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([organizationId, active])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actorRole  String
  actorId    String?
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@index([organizationId, createdAt])
}

enum AttendanceState {
  PENDING
  APPROVED
  REJECTED
}

enum AttendanceCaptureChannel {
  MANUAL
  GPS
  QR
  WIFI
  DEVICE
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
}

enum LeaveRequestState {
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

enum LeaveDecisionAction {
  APPROVED
  REJECTED
  CANCELED
}

enum LeaveRequestUnit {
  FULL_DAY
  HALF_DAY
  HOUR
}

enum PayrollState {
  PREVIEWED
  CONFIRMED
}

enum ApprovalDomain {
  ATTENDANCE
  LEAVE
  PAYROLL
}

enum ScheduleAnomalyIncidentState {
  ACKNOWLEDGED
  ASSIGNED
  RESOLVED
}

enum ScheduleAnomalyIncidentResolutionCode {
  FALSE_POSITIVE
  ATTENDANCE_CORRECTED
  MANUAL_CONFIRMED
  OTHER
}
