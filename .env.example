# Supabase public project
NEXT_PUBLIC_SUPABASE_URL=https://zjritguxyfdzzxuwcizv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase server key (server-side only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Prisma runtime URL (Supabase session pooler)
DATABASE_URL=postgresql://postgres.zjritguxyfdzzxuwcizv:YOUR-PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres

# Prisma migration URL (direct connection, not pooler)
DIRECT_URL=postgresql://postgres:YOUR-PASSWORD@db.zjritguxyfdzzxuwcizv.supabase.co:5432/postgres

# Optional: set "memory" for API route tests without DB
FLOWHR_DATA_ACCESS=prisma

# Optional: event publication adapter mode (noop|memory|http)
FLOWHR_EVENT_PUBLISHER=noop

# Optional: external HTTP event transport settings (used when FLOWHR_EVENT_PUBLISHER=http)
FLOWHR_EVENT_HTTP_URL=
FLOWHR_EVENT_HTTP_TOKEN=
FLOWHR_EVENT_HTTP_TIMEOUT_MS=3000
FLOWHR_EVENT_HTTP_RETRY_COUNT=2
FLOWHR_EVENT_HTTP_FAIL_OPEN=true

# Optional: payroll phase2 deduction preview endpoint toggle
FLOWHR_PAYROLL_DEDUCTIONS_V1=false

# Optional: payroll phase2 deduction profile mode toggle (requires deductions_v1=true)
FLOWHR_PAYROLL_DEDUCTION_PROFILE_V1=false

# Optional: emit scheduling anomaly automation event when anomaly report detects issues
FLOWHR_SCHEDULING_ANOMALY_ALERTS_ENABLED=false

# Optional: emit scheduling anomaly escalation event with severity/owner/retry metadata
FLOWHR_SCHEDULING_ANOMALY_ESCALATION_ENABLED=false
# format: MINOR:owner,MAJOR:owner,CRITICAL:owner
FLOWHR_SCHEDULING_ANOMALY_ESCALATION_POLICY=
FLOWHR_SCHEDULING_ANOMALY_ESCALATION_RETRY_MAX=3
FLOWHR_SCHEDULING_ANOMALY_ESCALATION_RETRY_BACKOFF_SECONDS=60

# Optional: enable tenant scoping (requires organization context via claim/header)
FLOWHR_TENANCY_V1=false

# Optional: enforce employee attendance capture via GPS channel with coordinates
FLOWHR_ATTENDANCE_GPS_REQUIRED=false

# Optional: enforce employee GPS coordinates inside configured geofence
FLOWHR_ATTENDANCE_GEOFENCE_ENABLED=false
FLOWHR_ATTENDANCE_GEOFENCE_LAT=
FLOWHR_ATTENDANCE_GEOFENCE_LNG=
FLOWHR_ATTENDANCE_GEOFENCE_RADIUS_METERS=300

# Optional: enforce employee GPS coordinates inside one of configured multi-site geofences
# format: SITE_ID:LAT:LNG:RADIUS_METERS;SITE_ID_2:LAT:LNG:RADIUS_METERS
FLOWHR_ATTENDANCE_MULTI_SITE_GEOFENCE_ENABLED=false
FLOWHR_ATTENDANCE_MULTI_SITE_GEOFENCE_SITES=

# Optional: enforce employee capture.deviceId against trusted allowlist
FLOWHR_ATTENDANCE_TRUSTED_DEVICE_ENABLED=false
FLOWHR_ATTENDANCE_TRUSTED_DEVICE_IDS=

# Optional: enforce employee capture attestation token mapping by deviceId
# format: DEVICE_ID:ATTESTATION_TOKEN,DEVICE_ID_2:ATTESTATION_TOKEN
FLOWHR_ATTENDANCE_DEVICE_ATTESTATION_ENABLED=false
FLOWHR_ATTENDANCE_DEVICE_ATTESTATION_TOKENS=
