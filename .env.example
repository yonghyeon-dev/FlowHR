# Required: Public Supabase project URL used by frontend and middleware.
NEXT_PUBLIC_SUPABASE_URL=https://zjritguxyfdzzxuwcizv.supabase.co
# Required: Public Supabase anon key used by frontend and middleware.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional: Show /ops links and debug panels in UI.
NEXT_PUBLIC_FLOWHR_DEV_TOOLS=false

# Required: Supabase service-role key for privileged server operations.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: Supabase URL alias used by selected scripts as fallback.
SUPABASE_URL=
# Required: Prisma runtime database URL (pooler endpoint recommended).
DATABASE_URL=postgresql://postgres.zjritguxyfdzzxuwcizv:YOUR-PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres
# Required: Prisma migration database URL (direct connection, not pooler).
DIRECT_URL=postgresql://postgres:YOUR-PASSWORD@db.zjritguxyfdzzxuwcizv.supabase.co:5432/postgres

# Optional: Data-access backend mode (memory|prisma).
FLOWHR_DATA_ACCESS=prisma
# Optional: Domain event publisher mode (noop|memory|http).
FLOWHR_EVENT_PUBLISHER=noop
# Optional: HTTP endpoint for external domain event delivery.
FLOWHR_EVENT_HTTP_URL=
# Optional: Bearer token for external domain event delivery.
FLOWHR_EVENT_HTTP_TOKEN=
# Optional: HTTP timeout in milliseconds for event delivery.
FLOWHR_EVENT_HTTP_TIMEOUT_MS=3000
# Optional: Retry count for event delivery failures.
FLOWHR_EVENT_HTTP_RETRY_COUNT=2
# Optional: Keep request flow open when event HTTP transport fails.
FLOWHR_EVENT_HTTP_FAIL_OPEN=true

# Optional: Generic alert webhook URL used by ops notifications.
FLOWHR_ALERT_WEBHOOK_URL=
